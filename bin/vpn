#!/bin/bash

# ==============================================================
#  vpn — Multi-profile openfortivpn manager for macOS
#  https://github.com/AndersonCRocha/openfortivpn-macos
# ==============================================================

VPN_BIN="/opt/homebrew/bin/openfortivpn"
STATE_DIR="$HOME/Library/Application Support/vpn"
PROFILES_DIR="$STATE_DIR/profiles"
LOG_DIR="/tmp"
KEYCHAIN_PREFIX="vpn"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# --- Profile helpers ---
init_state() { mkdir -p "$PROFILES_DIR"; }

pdir()      { echo "$PROFILES_DIR/$1"; }
pconf()     { echo "$PROFILES_DIR/$1/config"; }
pcert()     { echo "$PROFILES_DIR/$1/cert"; }
puserf()    { echo "$PROFILES_DIR/$1/user"; }
plog()      { echo "$LOG_DIR/vpn-$1.log"; }
psession()  { echo "vpn-$1"; }
pkeychain() { echo "$KEYCHAIN_PREFIX-$1"; }

profile_exists() { [ -f "$(pconf "$1")" ] && [ -f "$(puserf "$1")" ]; }

# Loads the profile into P_HOST/P_PORT/P_USER/P_CERT/P_PREAUTH (globals).
# PREAUTH=1 triggers a curl-based login (POST /remote/logincheck + follow
# hostcheck redirect) to grab SVPNCOOKIE, then hands it to openfortivpn via
# --cookie. Needed for gateways that require /remote/hostcheck_install (which
# openfortivpn itself doesn't follow) — e.g. some FortiToken Push + host-check
# corporate setups.
load_profile() {
    local p="$1"
    P_HOST=""; P_PORT="443"; P_USER=""; P_CERT=""; P_PREAUTH=""
    local k v
    while IFS='=' read -r k v; do
        [[ -z "$k" || "$k" =~ ^[[:space:]]*# ]] && continue
        case "$k" in
            HOST)    P_HOST="$v" ;;
            PORT)    P_PORT="$v" ;;
            PREAUTH) P_PREAUTH="$v" ;;
        esac
    done < "$(pconf "$p")"
    P_USER=$(cat "$(puserf "$p")" 2>/dev/null)
    P_CERT=$(cat "$(pcert "$p")" 2>/dev/null)
}

# URL-encodes a string using bash only (no python/jq dependency).
url_encode() {
    local s="$1" out="" i c
    for ((i=0; i<${#s}; i++)); do
        c="${s:i:1}"
        case "$c" in
            [a-zA-Z0-9._~-]) out+="$c" ;;
            *) out+=$(printf '%%%02X' "'$c") ;;
        esac
    done
    printf '%s' "$out"
}

# For PREAUTH profiles: POST credentials to /remote/logincheck (server pushes an
# MFA notification to the user's device), follow the hostcheck redirect, and
# extract the SVPNCOOKIE. Prints just the cookie value on success, empty on
# failure. Reads P_HOST/P_PORT/P_USER/PASS from the caller's scope.
preauth_get_cookie() {
    local jar
    jar=$(mktemp -t vpn-jar.XXXXXX)
    local pass_enc; pass_enc=$(url_encode "$PASS")
    local resp
    resp=$(curl -sk -c "$jar" -X POST "https://$P_HOST:$P_PORT/remote/logincheck" \
        -H "Content-Type: application/x-www-form-urlencoded" \
        --max-time 60 \
        -d "username=$P_USER&credential=$pass_enc&realm=&ajax=1" 2>/dev/null)
    local ret
    ret=$(echo "$resp" | grep -oE 'ret=[0-9]+' | head -1 | cut -d= -f2)
    if [ "$ret" != "1" ]; then
        rm -f "$jar"
        echo ""
        return
    fi
    # Follow the hostcheck_install redirect (sets SVPNCOOKIE) then the portal page.
    local redir
    redir=$(echo "$resp" | sed -nE 's/.*redir=([^,]+).*/\1/p' | head -1)
    if [ -n "$redir" ]; then
        curl -sk -b "$jar" -c "$jar" --max-time 15 \
            "https://$P_HOST:$P_PORT$redir" -o /dev/null 2>/dev/null
        curl -sk -b "$jar" -c "$jar" --max-time 15 \
            "https://$P_HOST:$P_PORT/sslvpn/portal/index.html" -o /dev/null 2>/dev/null
    fi
    local cookie
    cookie=$(awk '/SVPNCOOKIE/ {print $NF}' "$jar" | head -1)
    rm -f "$jar"
    echo "$cookie"
}

list_profiles_raw() {
    [ -d "$PROFILES_DIR" ] || return
    # Only fully-configured profiles are listed. Partial dirs are ignored here
    # (they can still be removed via `vpn remove`, which accepts a bare dir).
    find "$PROFILES_DIR" -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | sort | while read -r p; do
        profile_exists "$p" && echo "$p"
    done
}

is_running_any() { pgrep -x "openfortivpn" >/dev/null; }

# Returns "PID.name" of the most recent screen session for this profile (or empty).
psession_active() {
    local sname; sname=$(psession "$1")
    screen -ls 2>/dev/null | awk -v s="$sname" '$0 ~ "\\."s"\t" {print $1}' | tail -1
}

# Kills all screen sessions for this profile (leaves other profiles alone).
kill_profile_sessions() {
    local sname; sname=$(psession "$1")
    screen -ls 2>/dev/null | awk -v s="$sname" '$0 ~ "\\."s"\t" {print $1}' | while read -r s; do
        screen -S "$s" -X quit 2>/dev/null
    done
    screen -wipe >/dev/null 2>&1
}

# Kills every vpn-* screen (used by the global stop).
kill_all_vpn_sessions() {
    screen -ls 2>/dev/null | awk '$0 ~ /\.vpn-/ {print $1}' | while read -r s; do
        screen -S "$s" -X quit 2>/dev/null
    done
    screen -wipe >/dev/null 2>&1
}

# --- Commands ---

usage() {
    echo -e "${CYAN}🛡️  VPN Multi-Profile Manager${NC}"
    echo ""
    echo -e "${MAGENTA}PROFILES:${NC}"
    echo -e "  ${GREEN}vpn list${NC}                        List profiles + status"
    echo -e "  ${GREEN}vpn add <name>${NC}                  Create/edit a profile"
    echo -e "  ${GREEN}vpn clone <src> <new>${NC}           Duplicate a profile (only asks for a new user)"
    echo -e "  ${GREEN}vpn remove <name>${NC}               Remove a profile"
    echo ""
    echo -e "${MAGENTA}CONNECTION:${NC}"
    echo -e "  ${GREEN}vpn start <name>${NC}                🚀 Connect"
    echo -e "  ${BLUE}vpn token <name> <code>${NC}         📨 Send MFA token"
    echo -e "  ${RED}vpn stop <name>${NC}                 🛑 Disconnect"
    echo -e "  ${YELLOW}vpn status <name>${NC}               🔍 Diagnostics"
    echo -e "  ${YELLOW}vpn log <name>${NC}                  📄 Tail logs"
    echo -e "  ${YELLOW}vpn passwd <name>${NC}               🔑 Change password (Keychain)"
    echo -e "  ${YELLOW}vpn reset <name>${NC}                🗑️  Factory-reset a profile"
    echo -e "  ${RED}vpn stop${NC} (no args)              🛑 Disconnect whatever is active"
    echo ""
}

cmd_list() {
    init_state
    local profiles; profiles=$(list_profiles_raw)
    if [ -z "$profiles" ]; then
        echo -e "${YELLOW}No profiles configured.${NC}"
        echo -e "Create one with: ${BLUE}vpn add <name>${NC}"
        return
    fi

    printf "${MAGENTA}%-20s %-30s %s${NC}\n" "PROFILE" "HOST" "STATE"
    printf "%-20s %-30s %s\n" "-------" "----" "-----"
    local p
    while read -r p; do
        load_profile "$p"
        local state="🔴 offline"
        local session; session=$(psession_active "$p")
        if [ -n "$session" ]; then
            if is_running_any; then
                state="🟢 online ($session)"
            else
                state="⚠️  orphan screen ($session)"
            fi
        fi
        printf "%-20s %-30s %s\n" "$p" "$P_HOST" "$state"
    done <<< "$profiles"
}

cmd_add() {
    local p="$1"
    [ -z "$p" ] && echo -e "${RED}Usage: vpn add <name>${NC}" && exit 1
    if [[ ! "$p" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        echo -e "${RED}Invalid name. Use only letters, digits, ._-${NC}"; exit 1
    fi
    init_state

    echo -e "${CYAN}🔧 Configuring profile: ${MAGENTA}$p${NC}"

    local existing_host="" existing_port="443" existing_user=""
    if profile_exists "$p"; then
        load_profile "$p"
        existing_host="$P_HOST"
        existing_port="${P_PORT:-443}"
        existing_user="$P_USER"
    fi

    local HOST_IN PORT_IN USER_IN
    read -p "Host [${existing_host}]: " HOST_IN
    HOST_IN="${HOST_IN:-$existing_host}"
    [ -z "$HOST_IN" ] && echo -e "${RED}Host is required.${NC}" && exit 1

    read -p "Port [${existing_port}]: " PORT_IN
    PORT_IN="${PORT_IN:-$existing_port}"

    read -p "Username [${existing_user}]: " USER_IN
    USER_IN="${USER_IN:-$existing_user}"
    [ -z "$USER_IN" ] && echo -e "${RED}Username is required.${NC}" && exit 1

    # Only create the dir after validating everything — avoids partial profiles on abort.
    mkdir -p "$(pdir "$p")"
    cat > "$(pconf "$p")" <<EOF
HOST=$HOST_IN
PORT=$PORT_IN
EOF
    echo "$USER_IN" > "$(puserf "$p")"

    echo -e "${GREEN}✅ Profile saved: $(pdir "$p")${NC}"
    echo -e "${YELLOW}💡 The password will be asked on the first ${BLUE}vpn start $p${NC}"
}

cmd_remove() {
    local p="$1"
    [ -z "$p" ] && echo -e "${RED}Usage: vpn remove <name>${NC}" && exit 1
    # Accepts any profile dir, even a partial one without config.
    [ ! -d "$(pdir "$p")" ] && { echo -e "${RED}Profile '$p' does not exist.${NC}"; exit 1; }
    if [ -n "$(psession_active "$p")" ]; then
        echo -e "${RED}❌ Profile '$p' has an active session. Run 'vpn stop $p' first.${NC}"; exit 1
    fi
    rm -rf "$(pdir "$p")"
    security delete-generic-password -s "$(pkeychain "$p")" >/dev/null 2>&1
    echo -e "${YELLOW}🗑️  Profile '$p' removed (config + Keychain).${NC}"
}

cmd_start() {
    local p="$1"
    init_state
    load_profile "$p"

    if is_running_any; then
        local session; session=$(psession_active "$p")
        if [ -n "$session" ]; then
            echo -e "${YELLOW}⚠️  Profile '$p' is already active.${NC}"
        else
            echo -e "${RED}❌ Another VPN is already active (openfortivpn only allows one at a time).${NC}"
            echo -e "Run ${BLUE}vpn stop${NC} first, or check with ${BLUE}vpn list${NC}."
        fi
        return
    fi

    local KS; KS=$(pkeychain "$p")
    local LOG; LOG=$(plog "$p")
    local SESSION; SESSION=$(psession "$p")

    echo -e "${GREEN}🔐 Validating credentials for: ${CYAN}$P_USER${NC} (${MAGENTA}$p${NC})"
    local PASS
    PASS=$(security find-generic-password -a "$P_USER" -s "$KS" -w 2>/dev/null)
    if [ -z "$PASS" ]; then
        echo -e "${YELLOW}🔑 Password not found in Keychain.${NC}"
        echo -n "Enter password (hidden input): "
        read -s PASS
        echo ""
        [ -z "$PASS" ] && exit 1
        security add-generic-password -U -a "$P_USER" -s "$KS" -w "$PASS"
    fi

    local CERT_FLAG=""
    [ -n "$P_CERT" ] && CERT_FLAG="--trusted-cert $P_CERT"

    # PREAUTH: run the curl-based login flow, receive the MFA push, extract the
    # SVPNCOOKIE, and use --cookie instead of -u/-p.
    local COOKIE=""
    if [ -n "$P_PREAUTH" ]; then
        echo -e "${GREEN}🔔 Sending push notification — ${YELLOW}approve it on your device${NC}"
        COOKIE=$(preauth_get_cookie)
        if [ -z "$COOKIE" ]; then
            echo -e "${RED}❌ Pre-auth failed (login rejected or push not approved).${NC}"
            echo -e "Check password: ${BLUE}vpn passwd $p${NC}"
            return 1
        fi
        echo -e "${GREEN}✅ Session cookie captured.${NC}"
    fi

    local ATTEMPT=0
    while [ $ATTEMPT -lt 2 ]; do
        echo -e "${GREEN}🚀 Connecting to $P_HOST:$P_PORT...${NC}"
        echo "--- Starting $(date) [profile=$p] ---" > "$LOG"

        local CMD
        if [ -n "$P_PREAUTH" ]; then
            CMD="sudo $VPN_BIN $P_HOST:$P_PORT --cookie 'SVPNCOOKIE=$COOKIE' $CERT_FLAG --set-dns=1 --pppd-use-peerdns=1"
        else
            CMD="sudo $VPN_BIN $P_HOST:$P_PORT -u '$P_USER' -p '$PASS' $CERT_FLAG --set-dns=1 --pppd-use-peerdns=1"
        fi

        kill_profile_sessions "$p"
        screen -dmS "$SESSION" bash -c "$CMD > $LOG 2>&1"

        echo -n "⏳ Waiting for server"
        local COUNT=0
        local RETRY_CERT=0
        while [ $COUNT -lt 20 ]; do
            if grep -q "Two-factor authentication token" "$LOG"; then
                echo -e "\n${GREEN}✅ Server responded!${NC}"
                echo -e "${YELLOW}📩 Type: ${BLUE}vpn token $p <code>${NC}"
                return 0
            elif grep -q "Tunnel is up" "$LOG"; then
                echo -e "\n${GREEN}✅ Connected directly!${NC}"
                return 0
            elif grep -q "Gateway certificate validation failed" "$LOG"; then
                echo -e "\n${YELLOW}⚠️  New certificate detected.${NC}"
                local NEW_HASH; NEW_HASH=$(grep -oE "[a-f0-9]{64}" "$LOG" | tail -1)
                if [ -n "$NEW_HASH" ]; then
                    echo -e "${CYAN}💡 Updating hash: $NEW_HASH${NC}"
                    echo "$NEW_HASH" > "$(pcert "$p")"
                    CERT_FLAG="--trusted-cert $NEW_HASH"
                    sudo pkill openfortivpn
                    kill_profile_sessions "$p"
                    RETRY_CERT=1
                    ((ATTEMPT++))
                    echo -e "${BLUE}🔄 Restarting...${NC}"
                    break
                fi
            elif grep -qE "(Could not authenticate|authentication failed|wrong credentials|invalid credentials|permission denied)" "$LOG"; then
                echo -e "\n${RED}❌ Authentication failed. Check the password / username.${NC}"
                echo -e "Change password with: ${BLUE}vpn passwd $p${NC}"
                kill_profile_sessions "$p"
                return 1
            elif grep -qE "(Could not resolve|no such host|Connection refused|Connection timed out|Network is unreachable)" "$LOG"; then
                echo -e "\n${RED}❌ Could not reach $P_HOST:$P_PORT.${NC}"
                kill_profile_sessions "$p"
                return 1
            fi
            echo -n "."
            sleep 1
            ((COUNT++))
        done

        # Reached this point with no match: only retry if a cert refresh triggered it. Otherwise fail.
        if [ $RETRY_CERT -eq 0 ]; then
            echo -e "\n${RED}❌ Connection failed (20s timeout with no expected response).${NC}"
            echo -e "Check that ${MAGENTA}/etc/sudoers.d/${NC} allows ${VPN_BIN}."
            echo -e "Logs: ${BLUE}vpn log $p${NC}"
            kill_profile_sessions "$p"
            return 1
        fi
    done
    # Fell out of the outer loop by exhausting ATTEMPT.
    echo -e "\n${RED}❌ Exhausted certificate retry attempts.${NC}"
    kill_profile_sessions "$p"
    return 1
}

cmd_clone() {
    local src="$1" dst="$2"
    [ -z "$src" ] || [ -z "$dst" ] && echo -e "${RED}Usage: vpn clone <src-profile> <new-profile>${NC}" && exit 1
    profile_exists "$src" || { echo -e "${RED}Source profile '$src' does not exist.${NC}"; exit 1; }
    if [[ ! "$dst" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        echo -e "${RED}Invalid name. Use only letters, digits, ._-${NC}"; exit 1
    fi
    [ -d "$(pdir "$dst")" ] && { echo -e "${RED}Profile '$dst' already exists.${NC}"; exit 1; }

    load_profile "$src"
    echo -e "${CYAN}📋 Cloning ${MAGENTA}$src${NC} → ${MAGENTA}$dst${NC}"
    echo -e "Host:         ${CYAN}$P_HOST:$P_PORT${NC}"
    echo -e "Current user: ${CYAN}$P_USER${NC}"

    local NEW_USER
    read -p "New username [${P_USER}]: " NEW_USER
    NEW_USER="${NEW_USER:-$P_USER}"

    mkdir -p "$(pdir "$dst")"
    cat > "$(pconf "$dst")" <<EOF
HOST=$P_HOST
PORT=$P_PORT
EOF
    echo "$NEW_USER" > "$(puserf "$dst")"

    echo -e "${GREEN}✅ Profile '$dst' created.${NC}"
    echo -e "${YELLOW}💡 Set the password with: ${BLUE}vpn passwd $dst${NC}"
    echo -e "   or connect via ${BLUE}vpn start $dst${NC} (it will prompt)."
}

cmd_passwd() {
    local p="$1"
    load_profile "$p"
    echo -e "${CYAN}🔑 Changing password for profile ${MAGENTA}$p${NC} (user ${CYAN}$P_USER${NC})"
    echo -n "New password (hidden input): "
    local NEW_PASS
    read -s NEW_PASS
    echo ""
    [ -z "$NEW_PASS" ] && echo -e "${RED}❌ Cancelled (empty password).${NC}" && exit 1
    security add-generic-password -U -a "$P_USER" -s "$(pkeychain "$p")" -w "$NEW_PASS"
    echo -e "${GREEN}✅ Password updated in Keychain.${NC}"
}

cmd_token() {
    local p="$1" code="$2"
    [ -z "$code" ] && echo -e "${RED}Usage: vpn token $p 123456${NC}" && exit 1
    local target; target=$(psession_active "$p")
    if [ -z "$target" ]; then
        echo -e "${RED}❌ Profile '$p' has no active session. Run: vpn start $p${NC}"
        exit 1
    fi
    echo -e "${GREEN}📨 Sending to ${CYAN}$target${NC}..."
    screen -S "$target" -p 0 -X stuff "$code$(printf \\r)"
}

cmd_stop() {
    local p="$1"
    if [ -n "$p" ]; then
        echo -e "${RED}🛑 Stopping '$p'...${NC}"
    else
        local active
        active=$(screen -ls 2>/dev/null | awk '$0 ~ /\.vpn-/ {print $1}' | tail -1 | sed -E 's/^[0-9]+\.vpn-//')
        if [ -n "$active" ]; then
            echo -e "${RED}🛑 Stopping '$active'...${NC}"
        elif is_running_any; then
            echo -e "${RED}🛑 Stopping orphan openfortivpn...${NC}"
        else
            echo -e "${YELLOW}⚠️  Nothing running.${NC}"; return 0
        fi
    fi
    if is_running_any; then sudo pkill openfortivpn; fi
    # Always kill every vpn-* screen — only one VPN can be active at a time, so this is safe.
    kill_all_vpn_sessions
    sleep 1
    if is_running_any; then sudo pkill -9 openfortivpn; fi
    echo -e "${GREEN}✅ Off.${NC}"
}

cmd_status() {
    local p="$1"
    load_profile "$p"
    echo -e "${BLUE}ℹ️  Diagnostics: ${MAGENTA}$p${NC}"
    echo -e "Host:    ${CYAN}$P_HOST:$P_PORT${NC}"
    echo -e "User:    ${CYAN}$P_USER${NC}"

    if security find-generic-password -a "$P_USER" -s "$(pkeychain "$p")" >/dev/null 2>&1; then
        echo -e "Pass:    ${GREEN}✅ Saved in Keychain${NC}"
    else
        echo -e "Pass:    ${YELLOW}⚠️  Not configured${NC}"
    fi

    if [ -n "$P_CERT" ]; then
        echo -e "Cert:    ${GREEN}✅ Detected${NC} (${P_CERT:0:8}...)"
    else
        echo -e "Cert:    ${YELLOW}⏳ Awaiting connection${NC}"
    fi

    echo -e "Path:    $(pdir "$p")"

    local session; session=$(psession_active "$p")
    if [ -n "$session" ] && is_running_any; then
        local VPN_IP; VPN_IP=$(ifconfig ppp0 2>/dev/null | grep "inet " | awk '{print $2}')
        echo -e "State:   ${GREEN}🟢 ONLINE${NC} (screen: $session, PID: $(pgrep -x openfortivpn))"
        [ -n "$VPN_IP" ] && echo -e "VPN IP:  ${CYAN}$VPN_IP${NC}" || echo -e "VPN IP:  ${YELLOW}Negotiating...${NC}"
    else
        echo -e "State:   ${RED}🔴 OFFLINE${NC}"
    fi
}

cmd_log() {
    local p="$1"
    local LOG; LOG=$(plog "$p")
    [ ! -f "$LOG" ] && echo -e "${RED}No log for '$p'.${NC}" && exit 1
    echo -e "${CYAN}📄 $LOG (Ctrl+C to exit)${NC}"
    tail -f "$LOG" | grep -v "password"
}

cmd_reset() {
    local p="$1"
    if [ -n "$(psession_active "$p")" ] || is_running_any; then
        echo -e "${RED}❌ VPN is active. Run 'vpn stop $p' first.${NC}"; exit 1
    fi
    rm -rf "$(pdir "$p")"
    security delete-generic-password -s "$(pkeychain "$p")" >/dev/null 2>&1
    echo -e "${YELLOW}🗑️  Profile '$p' reset.${NC}"
}

# --- Dispatcher ---
# Format: vpn <action> [args]  (verb-noun, git/docker style)

ACTION="$1"

require_profile() {
    local p="$1" act="$2"
    if [ -z "$p" ]; then
        echo -e "${RED}Usage: vpn $act <profile>${NC}"; exit 1
    fi
    profile_exists "$p" || { echo -e "${RED}Profile '$p' does not exist. Create with: vpn add $p${NC}"; exit 1; }
}

case "$ACTION" in
    ""|help|--help|-h)  usage ;;
    list|ls)            cmd_list ;;
    add)                cmd_add "$2" ;;
    clone|cp|duplicate) cmd_clone "$2" "$3" ;;
    remove|rm)          cmd_remove "$2" ;;
    stop)               [ -n "$2" ] && require_profile "$2" stop; cmd_stop "$2" ;;
    start)              require_profile "$2" start;  cmd_start  "$2" ;;
    token)              require_profile "$2" token;  cmd_token  "$2" "$3" ;;
    status)             require_profile "$2" status; cmd_status "$2" ;;
    log)                require_profile "$2" log;    cmd_log    "$2" ;;
    passwd)             require_profile "$2" passwd; cmd_passwd "$2" ;;
    reset)              require_profile "$2" reset;  cmd_reset  "$2" ;;
    *)
        echo -e "${RED}Invalid command: $ACTION${NC}"
        usage
        exit 1
        ;;
esac
